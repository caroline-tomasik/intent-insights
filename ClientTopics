for client in CLIENT_NAMES:
    n_top = top_topics.filter(F.col("client_name") == client).select("topic_id").distinct().count()
    print("=" * 70)
    print(f"RANKING: {client}   method={SCORE_METHOD}   top topics kept={n_top:,}")
    print("  Top subcategories:")
    (
        subcat_top.filter(F.col("client_name") == client).orderBy("group_rank")
        .select("group_rank", "TOPIC_CATEGORY", "TOPIC_SUBCATEGORY",
                "n_top_topics", "best_topic_rank", "median_local_lift", "avg_score")
        .show(15, truncate=35)
    )
    print("  Top categories:")
    (
        cat_top.filter(F.col("client_name") == client).orderBy("group_rank")
        .select("group_rank", "TOPIC_CATEGORY", "n_subcategories", "n_top_topics",
                "best_topic_rank", "median_local_lift", "avg_score")
        .show(10, truncate=35)
    )


# ============================================================
# Write per client
# ============================================================

def write_csv(df, path, quote_all=False):
    w = df.coalesce(1).write.mode("overwrite").option("header", "true")
    if quote_all:
        w = w.option("quoteAll", "true")
    w.csv(path)


for client in CLIENT_NAMES:
    output_path = OUTPUT_PATH_TEMPLATE.format(client=client, date=run_date)
    write_csv(
        result.filter(F.col("client_name") == client)
        .orderBy(F.col("index").desc_nulls_last(), F.col("a").desc()),
        output_path,
    )
    print(f"Wrote full subcategory counts: {output_path}")

    subcat_path = SUBCAT_TOP_PATH_TEMPLATE.format(client=client, date=run_date)
    write_csv(subcat_top.filter(F.col("client_name") == client).orderBy("group_rank"), subcat_path, True)
    print(f"Wrote subcategories (>= {MIN_TOP_TOPICS_PER_SUBCATEGORY} of top-{TOP_K} topics): {subcat_path}")

    cat_path = CAT_TOP_PATH_TEMPLATE.format(client=client, date=run_date)
    write_csv(cat_top.filter(F.col("client_name") == client).orderBy("group_rank"), cat_path, True)
    print(f"Wrote categories (those with >= 1 subcategory shown): {cat_path}")


